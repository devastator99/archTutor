# --- API ---------------------------------------------------------------
# Server-only base URL (server components, and the /api proxy route). Not
# exposed to the browser. Must be absolute: a server-side fetch of a relative
# path has nothing to resolve it against.
API_BASE_URL=http://127.0.0.1:8000

# Browser-visible base URL. Two forms:
#
#   /api                     relative: the browser calls this site's own origin
#                            and the proxy route forwards to API_BASE_URL. The
#                            API is never exposed publicly, so this is the form
#                            to use when publishing the app behind one address.
#   http://127.0.0.1:8000    absolute: the browser calls the API directly, so
#                            the API must be reachable from the browser and
#                            listed in the backend's CORS_ORIGINS. Convenient
#                            for local development.
NEXT_PUBLIC_API_BASE_URL=/api
