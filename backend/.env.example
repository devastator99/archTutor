# --- Database (PostgreSQL) --------------------------------------------
# The local dev database created by:
#   createdb archtutor  (or see README "Database setup")
POSTGRES_USER=archtutor
POSTGRES_PASSWORD=archtutor
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=archtutor

# --- HTTP server -------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- CORS --------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Tutor (LLM) -------------------------------------------------------
# Any OpenAI-compatible chat completions endpoint. The base URL is the API root
# without the trailing /chat/completions, which the tutor appends.
#
# Groq, which is what this project is developed against:
#   TUTOR_BASE_URL=https://api.groq.com/openai/v1
#   TUTOR_API_KEY=gsk_...                       # console.groq.com/keys
#   TUTOR_MODEL=openai/gpt-oss-20b
#   TUTOR_REASONING_EFFORT=low        # optional; reasoning models only
# Other models verified to work on the same account: openai/gpt-oss-120b
# (slower, spends part of its token budget reasoning) and qwen/qwen3.8-27b
# (fastest). The key is a secret: it belongs in this file, which is ignored by
# git, and nowhere else.
#
# Leave these blank to run without a tutor. Every explanation then comes from the
# deterministic layer and the product is complete; a model is an enhancement, not
# a dependency.
TUTOR_BASE_URL=
TUTOR_API_KEY=
TUTOR_MODEL=
